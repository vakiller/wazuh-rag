# =============================================================================
# RAG Wazuh System - Test Environment Configuration
# =============================================================================
# This file contains test/development settings
# Copy to .env for testing: cp .env.test .env

# =============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# =============================================================================
# For docker-compose testing, use 'postgres' as host
# For local PostgreSQL, use 'localhost'
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wazuh_rag
DB_USER=wazuh_user
DB_PASSWORD=test_password_123

# =============================================================================
# WAZUH INDEXER CONFIGURATION
# =============================================================================
# Using your existing Wazuh Indexer from PROJECT.md
WAZUH_INDEXER_HOST=172.16.235.140
WAZUH_INDEXER_PORT=9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=SecretPassword

# SSL/TLS settings (set to false for testing with self-signed certs)
WAZUH_INDEXER_SSL=true
WAZUH_INDEXER_VERIFY_CERTS=false

# Collection settings (faster for testing)
WAZUH_POLL_INTERVAL=300
WAZUH_BATCH_SIZE=100
WAZUH_MIN_ALERT_LEVEL=0

# =============================================================================
# OPENCTI CONFIGURATION
# =============================================================================
# Using your existing OpenCTI from PROJECT.md
OPENCTI_URL=http://100.114.206.116:8080
OPENCTI_TOKEN=1c8d9547-f6be-4bd2-8430-d1ae76e3d1ef
OPENCTI_VERIFY_SSL=false

# =============================================================================
# LLM CONFIGURATION (Ollama)
# =============================================================================
# Using your existing Ollama service from PROJECT.md
LLM_BASE_URL=http://192.168.1.2:11434
LLM_MODEL=llama3.1:8b-instruct-q4_K_M
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=120

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
# Logging (use DEBUG for testing)
LOG_LEVEL=INFO

# Timezone
TZ=UTC

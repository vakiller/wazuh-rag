# ============================================================================
# Wazuh Indexer Connection Settings
# ============================================================================

# Indexer hostname or IP address (NO https:// prefix, just IP/hostname)
WAZUH_INDEXER_HOST=172.16.235.140

# Indexer port (default: 9200)
WAZUH_INDEXER_PORT=9200

# Authentication credentials
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=SecretPassword

# SSL/TLS settings
WAZUH_INDEXER_SSL=true
WAZUH_INDEXER_VERIFY_CERTS=false

# Path to CA certificates (optional, leave empty to use system defaults)
# WAZUH_INDEXER_CA_CERTS=/path/to/ca-certificates.crt

# ============================================================================
# Collection Settings
# ============================================================================

# Polling interval in seconds (how often to check for new alerts)
# Recommended: 300 (5 minutes) for standard environments
# Use 60-180 for high-priority/fast-response environments
WAZUH_POLL_INTERVAL=300

# Number of documents to fetch per batch
# Higher values improve performance but use more memory
# Range: 100-10000, recommended: 1000
WAZUH_BATCH_SIZE=1000

# Minimum alert level to collect (0-15)
# 0 = all alerts, 3 = low, 5 = medium, 7 = high, 10+ = critical
# Set to 0 to collect everything, or 5 to focus on medium+ severity
WAZUH_MIN_ALERT_LEVEL=0

# ============================================================================
# Output Settings
# ============================================================================

# Directory for JSONL file output (when using --output file)
WAZUH_OUTPUT_DIR=./collected_alerts

# SQLite database path (when using --output sqlite)
WAZUH_SQLITE_DB=./wazuh_alerts.db

# State file for tracking collection progress
WAZUH_STATE_FILE=.wazuh_collector_state.json

# ============================================================================
# Kafka Settings (optional, if using Kafka output)
# ============================================================================

# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# KAFKA_TOPIC=wazuh.alerts.normalized
# KAFKA_COMPRESSION=gzip

# ============================================================================
# Logging Settings (optional)
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO

# Log file path (optional, leave empty for console-only logging)
# LOG_FILE=./wazuh_collector.log

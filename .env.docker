# =============================================================================
# RAG Wazuh System - Docker Environment Configuration
# =============================================================================
# Copy this file to .env and update with your actual values
# Usage: docker-compose --env-file .env up -d

# =============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# =============================================================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=wazuh_rag
DB_USER=wazuh_user
DB_PASSWORD=changeme_db_password

# =============================================================================
# WAZUH INDEXER CONFIGURATION
# =============================================================================
# Wazuh Indexer (OpenSearch) connection settings
WAZUH_INDEXER_HOST=172.16.235.140
WAZUH_INDEXER_PORT=9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=changeme_wazuh_password

# SSL/TLS settings
WAZUH_INDEXER_SSL=true
WAZUH_INDEXER_VERIFY_CERTS=false

# Collection settings
WAZUH_POLL_INTERVAL=300
WAZUH_BATCH_SIZE=1000
WAZUH_MIN_ALERT_LEVEL=0

# =============================================================================
# OPENCTI CONFIGURATION
# =============================================================================
# OpenCTI threat intelligence platform
OPENCTI_URL=http://100.114.206.116:8080
OPENCTI_TOKEN=changeme_opencti_token
OPENCTI_VERIFY_SSL=false

# =============================================================================
# LLM CONFIGURATION (Ollama)
# =============================================================================
# Ollama LLM service for threat analysis
LLM_BASE_URL=http://192.168.1.11:11434
LLM_MODEL=llama3.1:8b-instruct-q4_K_M
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=120

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
# Logging
LOG_LEVEL=INFO

# Timezone
TZ=UTC

# =============================================================================
# DASHBOARD CONFIGURATION
# =============================================================================
# The dashboard is accessible at http://localhost:3000
# API is proxied through nginx, no additional configuration needed
# Note: VITE_API_URL is set at build time in Dockerfile to /api

DASHBOARD_PORT=3000
DASHBOARD_API_PORT=8000

# =============================================================================
# OPTIONAL: PGADMIN CONFIGURATION
# =============================================================================
# Uncomment these and run with: docker-compose --profile management up -d
# to enable pgAdmin web interface for database management

PGADMIN_EMAIL=admin@wazuh-rag.local
PGADMIN_PASSWORD=changeme_pgadmin_password
PGADMIN_PORT=5050

# =============================================================================
# CRON SCHEDULES (Configured in docker/crontab - For Reference Only)
# =============================================================================
# These are set in the crontab file and cannot be changed via environment variables
#
# Wazuh Retrieval:    Every 5 minutes (*/5 * * * *)
# Knowledge Ingest:   Every 7 days, Sunday at 2 AM (0 2 * * 0)
# LLM Analysis Hourly: Every hour at :15 (15 * * * *)
# LLM Analysis Daily:  Every day at 3 AM (0 3 * * *)
#
# To customize schedules, edit docker/crontab and rebuild the image
